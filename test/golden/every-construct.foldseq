foldseq 1
title "Every construct, folding nothing sensible"
sheet "examples/crane.fold"
anchor (19/20, 1/3)
white side up
start folded {
  layers (1/4, 1/5) above (3/8, 5/9)
  layers (4/9, 3/8) above (1/4, 1/5)
}

step names "Name two points and two lines." {
  mark peak = corner north-east
  mark under = midpoint of [corner south-west, centre] in face containing (1/8, 1/8)
  let diagonal = [corner south-west, corner north-east]
  let third = fraction 1/3 along [corner south-west, corner south-east]
}

step folds "Every way of naming a fold line." {
  fold valley corner south-east to centre
  fold mountain 90° edge west to edge east nearest centre all layers moving peak
  fold valley 45/2° perpendicular to (corner south-west to centre) through centre top layer
  fold valley corner north-west to edge south through midpoint of edge north nearest corner north-east top 3 layers
  fold valley peak to edge south and third to diagonal top flap
  fold mountain centre to edge east perpendicular to edge north
  fold valley corner north-east to crease [corner south-west, centre]
  fold valley model [(-1/2, 0), (3, 1/4)] moving meet hinge of names crease of names
  fold valley [under, centre] moving end of crease of names nearest centre
  fold and unfold valley diagonal moving corner north-west
}

step {
  turn over left-right
  turn over top-bottom
  rotate 1/8 turn anticlockwise
  rotate 2/8 turn clockwise
  anchor centre
}

step base "The macro-moves." {
  collapse at centre keeping [corner south-west, corner north-east] flat until 180° sample 30° 60° 90°
  collapse at centre until 90°
  rabbit-ear at corner north-west until 90°
  petal tip corner south-east until 175°
  petal top flap until 175°
}

step "Blocks inside a step." {
  together {
    continue base until 180°
    continue folds until 180°
  }
  pose {
    crease [centre, corner north-west] at -90°
    crease [centre, corner south-east] at 45/2°
  }
  unfold names folds
}

step "Everything else." {
  repeat names
  repeat names..folds mirrored across [corner south-west, corner north-east]
  repeat base turned 2/4 about centre
  checkpoint "crane.fold" {
    stacking first
  }
  checkpoint "half.fold" {
    layers peak above centre
  }
  not modelled "inside reverse fold"
  expect refused FlapCovered {
    fold valley 90° corner north-west to midpoint of edge north
  }
}

closing "Done, \"more or less\"."
