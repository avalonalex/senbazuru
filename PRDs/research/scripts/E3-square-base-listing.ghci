-- E3 section G: under the held-face rule, does a page turn's direction depend
-- on which hinge crease is listed first? Run from the repository root:
--
--   stack ghci senbazuru:lib --ghci-options=-v0 < PRDs/research/scripts/E3-square-base-listing.ghci
--
-- Written against 6c5048b, where Origami.Flap.prepareFlapToward read the way up
-- of the face held still beside the first hinge crease (PRD 05 L14, #344).
-- Spine edge 14 is F in the fixture and Flap turns only M, V or U creases, so
-- it is relabelled U here; only its label changes, not its angle of 0.
:set -XOverloadedStrings
import Senbazuru.Fold.Load
import Senbazuru.Fold.Types
import Senbazuru.Origami.Folding
import Senbazuru.Origami.Flap
import qualified Data.List as L
import qualified Data.IntMap.Strict as IM
Right file <- loadFoldFile "examples/square-base.fold"
let key = keyFrame file
let relabel = key {edgesAssignment = [if i == 14 then Unassigned else a | (i, a) <- zip [0 :: Int ..] (edgesAssignment key)]}
let Right folded = foldFrameWith relabel
let rings = zip [0 :: Int ..] (facesVertices (foldedPattern folded))
let faceWith vs = [i | (i, r) <- rings, all (`elem` r) (map VertexId vs)]
let [upper] = faceWith [8,3,7]
let [lower] = faceWith [8,7,0]
let besideEdge e = [i | (i, r) <- rings, let (a, b) = edgesVertices relabel !! e, a `elem` r, b `elem` r]
let up i = maybe "missing" (\p -> if facesUp p then "top up" else "upside down") (IM.lookup i (foldedPlacements folded))
putStrLn ("page faces " ++ show (upper, lower) ++ ", joined by edge 15 at " ++ show (edgesFoldAngle relabel !! 15) ++ "; face " ++ show upper ++ " " ++ up upper ++ ", face " ++ show lower ++ " " ++ up lower)
putStrLn ("edge 14 joins faces " ++ show (besideEdge 14) ++ ", edge 8 joins faces " ++ show (besideEdge 8) ++ " at " ++ show (edgesFoldAngle relabel !! 8))
putStrLn ("held faces: face 5 " ++ up 5 ++ ", face 0 " ++ up 0 ++ " (the root, held still by folding)")
let field name s = takeWhile (/= ']') (drop (length name) (head [t | t <- L.tails s, name `L.isPrefixOf` t]))
let travels = either show (field "creaseTravels = [" . show)
putStrLn ("towards +z, listed [14, 8]: " ++ travels (prepareFlapToward [EdgeId 14, EdgeId 8] (FaceId upper) 180 TowardPlusZ folded))
putStrLn ("towards +z, listed [8, 14]: " ++ travels (prepareFlapToward [EdgeId 8, EdgeId 14] (FaceId lower) 180 TowardPlusZ folded))
putStrLn ("towards -z, listed [14, 8]: " ++ travels (prepareFlapToward [EdgeId 14, EdgeId 8] (FaceId upper) 180 TowardMinusZ folded))
putStrLn ("towards -z, listed [8, 14]: " ++ travels (prepareFlapToward [EdgeId 8, EdgeId 14] (FaceId lower) 180 TowardMinusZ folded))
